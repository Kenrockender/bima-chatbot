# OpenRouter — required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chat/roleplay model. Haiku 4.5 = smart + cheap; static prompt prefixes
# are prompt-cached so repeated turns bill mostly at the cache-read rate.
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5
# Optional per-task overrides. Leave blank to reuse OPENROUTER_CHAT_MODEL (cheap,
# single-model default). Only set these to spend a smarter model on the live
# coach / end-of-session evaluation specifically.
OPENROUTER_COACH_MODEL=
OPENROUTER_EVAL_MODEL=

# Firebase Admin (backend). See backend/.env.example for details.
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAILS=
ALLOWED_EMAIL_DOMAINS=bcalife.co.id

ESCALATION_WHATSAPP=+62 812-0000-0000
ESCALATION_EMAIL=hr-it@bcalife.co.id
