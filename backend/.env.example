# LLM via OpenRouter — required. Default: Claude 3.5 Haiku (reliable JSON, no cutoffs).
# Alternatives: deepseek/deepseek-chat (free but unreliable), google/gemini-2.0-flash-001 (cheap)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-haiku

# Firebase Admin — required. Paste the service-account JSON on one line, or
# point FIREBASE_SERVICE_ACCOUNT_FILE at a JSON file path instead.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Comma-separated. admin_emails grants PDF-management access; leave empty and
# instead set the `admin:true` custom claim on admin accounts if you prefer.
ADMIN_EMAILS=
# Restrict who may sign in at all (empty = any Google account).
ALLOWED_EMAIL_DOMAINS=bcalife.co.id

# Temp dir used only while extracting PDF text (the text lives in Firestore).
UPLOAD_DIR=./data/uploads

ESCALATION_WHATSAPP=+62 812-0000-0000
ESCALATION_EMAIL=hr-it@bcalife.co.id
CORS_ORIGINS=http://localhost:3000

# ElevenLabs text-to-speech — optional. Set the key to give the customer a
# natural voice instead of the browser's robotic one. Cost is per-character;
# turbo v2.5 is cheap + low-latency and speaks Indonesian. The two voice IDs
# let the customer voice match the persona's gender (override to taste).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB

# Server-side speech-to-text — optional fallback for iOS/Safari (Web Speech API
# is unavailable there). Uses Groq's Whisper by default; set the key to enable.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
