{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "frontend-railway",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:BACKEND_URL='https://bima-chatbot-production.up.railway.app'; npm run dev --prefix frontend"
      ],
      "port": 3010,
      "autoPort": true
    }
  ]
}
